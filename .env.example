# ─────────────────────────────────────────────────────────────
# Éclat Résidences — variables publiques de configuration
# Copiez ce fichier en « .env » (local) ou saisissez ces valeurs dans
# le tableau de bord de votre hébergeur (Netlify, Vercel…), puis
# relancez le build.
#
# ⚠ Toutes les variables VITE_* sont intégrées au code envoyé au
#   navigateur : elles sont PUBLIQUES. N'y mettez jamais de secret
#   (mot de passe, clé API privée, clé de paiement…).
# ─────────────────────────────────────────────────────────────

# URL publique du site (sans « / » final). Sert au SEO, au sitemap et au QR code.
VITE_SITE_URL=https://www.eclatresidences.com

# ── Envoi des formulaires par e-mail ──────────────────────────
# Fournisseur : web3forms | formspree | (vide = mode démonstration, rien n'est envoyé)
VITE_FORM_PROVIDER=

# Web3Forms : « access key » reçue par e-mail sur https://web3forms.com
# Cette clé est publique par conception (elle ne permet que d'envoyer
# des messages vers l'adresse associée).
VITE_WEB3FORMS_ACCESS_KEY=

# Formspree : identifiant du formulaire (la partie après /f/ dans
# https://formspree.io/f/xxxxxxx)
VITE_FORMSPREE_FORM_ID=

# ── Coordonnées ───────────────────────────────────────────────
# Mettre « true » seulement quand la boîte contact@eclatresidences.com
# reçoit réellement les messages.
VITE_CONTACT_EMAIL_ACTIVE=false

# Numéro WhatsApp au format international, chiffres uniquement,
# sans « + » ni espaces (ex. 2376XXXXXXXX). Vide = bouton masqué.
VITE_WHATSAPP_NUMBER=

# ── Calendrier externe (facultatif) ───────────────────────────
# simplybook | calcom | (vide)
VITE_BOOKING_PROVIDER=
# Lien public de la page de réservation SimplyBook.me ou Cal.com
VITE_BOOKING_URL=

# ── Tarifs ────────────────────────────────────────────────────
# Publication de la grille tarifaire et du simulateur (page Nos solutions).
# Laisser « false » tant que la direction n'a pas validé la publication.
# En développement (npm run dev), un aperçu est toujours visible.
VITE_PUBLISH_PRICING=false
